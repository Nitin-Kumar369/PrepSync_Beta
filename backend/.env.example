# Gemini API Key (get from https://makersuite.google.com/app/apikeys)
GEMINI_API_KEY=your_api_key_here

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/engineering_books_rag

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=True
FASTAPI_RELOAD=True

# JWT & Security
JWT_SECRET_KEY=your_random_secret_key_min_32_characters_here_generate_with_secrets_token_hex()
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ChromaDB Configuration
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=engineering_books

# RAG Parameters (Tunable)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K_RETRIEVAL=5
RAG_TEMPERATURE=0.7
RAG_CONTEXT_WINDOW_MESSAGES=3
RAG_MAX_CONTEXT_LENGTH=4000

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=500
UPLOAD_FOLDER=./uploads

# Email (optional, for future notifications)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Logging
LOG_LEVEL=INFO
LOG_FILE=./backend.log

# CORS (for frontend)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]

# Environment
ENVIRONMENT=development  # or: production
